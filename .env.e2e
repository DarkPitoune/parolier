# Environment for the e2e build. Committed on purpose.
#
# These are the local Supabase stack's values. The anon key is a fixed
# demo key printed by `supabase start`, identical on every Supabase
# installation — it is not a secret and grants nothing beyond a database
# running on this machine.
#
# Loaded automatically by `vite build --mode e2e` (see the build:e2e
# script). Its whole job is to keep the bundle under test off production:
# before this file, playwright.config.ts built with .env, which inlined
# the live project URL into the binary the tests exercised.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Disables Sentry (src/main.tsx). Note the mode itself also disables the
# analytics insert, which is gated on MODE === "production" in SongPage —
# so an e2e run no longer writes rows to whatever database it points at.
VITE_E2E=true
