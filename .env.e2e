# Loaded by `vite build --mode e2e`, so the bundle under test points at the
# local stack rather than production. Committed deliberately: the anon key is
# the fixed demo key printed by `supabase start`, identical on every Supabase
# installation, and grants nothing beyond a database on this machine.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Disables Sentry. The mode also disables the analytics insert, which is gated
# on MODE === "production".
VITE_E2E=true
