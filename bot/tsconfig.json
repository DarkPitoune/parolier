{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2023"],
		"types": ["node"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"paths": {
			"@/*": ["./../src/*"]
		}
	},
	"include": ["src", "../database.types.ts", "../database-generated.types.ts", "../src/assets/types.d.ts"]
}
